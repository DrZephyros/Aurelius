{
  "name": "aura-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "audit": "node scripts/audit.mjs http://localhost:4173",
    "audit:fast": "node scripts/audit.mjs --serve dist --only desktop,mobile,landscape --stops 8",
    "audit:full": "npm run build && node scripts/audit.mjs --serve dist --tsc --poster"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.187.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "playwright": "^1.50.0",
    "pngjs": "^7.0.0"
  },
  "version": "19.0.0",
  "engines": {
    "node": ">=18.18"
  }
}
